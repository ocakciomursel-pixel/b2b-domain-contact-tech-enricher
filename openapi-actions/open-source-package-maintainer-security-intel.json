{
  "openapi": "3.1.0",
  "info": {
    "title": "NPM & PyPI Package Maintainer Email & Supply-Chain Spy",
    "description": "DevTools & Supply-Chain intelligence Actor: extracts NPM and PyPI package download volume, maintainer direct email addresses, license compliance, dependency counts, and release freshness.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "paths": {
    "/acts/lucacelli~open-source-package-maintainer-security-intel/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_open_source_package_maintainer_security_intel",
        "summary": "NPM & PyPI Package Scraper: Maintainer Emails & Stats API",
        "description": "Extract NPM and PyPI package download stats, maintainer emails, licenses, dependency counts & GitHub repo links for DevTools outreach ($0.50/1k packages).",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your Apify API Token"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "npmPackages": [
                    "crawlee",
                    "cheerio"
                  ],
                  "pypiPackages": [
                    "fastapi"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted JSON dataset array"
          }
        }
      }
    }
  }
}