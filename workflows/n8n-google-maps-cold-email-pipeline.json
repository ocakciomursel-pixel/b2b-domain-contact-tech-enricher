        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domains\": [ \"{{ $json.domain || $json.website }}\" ],\n  \"crawlContactPages\": true,\n  \"detectTechStack\": true\n}",
        "options": {
          "timeout": 180000
        }
      },
