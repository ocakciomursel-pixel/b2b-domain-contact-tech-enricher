        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"emails\": {{ JSON.stringify($json.emails || [$json.primaryEmail]) }}\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "node-apify-email-verifier",
      "name": "3. Bulk Email Verifier Pro (MX, SPF, DMARC & Disposable Check)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
