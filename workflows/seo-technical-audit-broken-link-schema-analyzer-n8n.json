        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"urls\": [\n    \"https://apify.com\",\n    \"https://cloudflare.com\"\n  ],\n  \"checkBrokenLinks\": true\n}",
        "options": {
          "timeout": 300000
        }
