      "name": "Run Apify Actor ($0.80/1k)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ],
      "notesInFlow": true,
      "notes": "Powered by https://apify.com/lucacelli/seo-technical-audit-broken-link-schema-analyzer ($0.80 per 1,000 pages)"
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Run Apify Actor ($0.80/1k)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}