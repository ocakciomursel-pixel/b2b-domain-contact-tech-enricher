{
  "title": "360° Open-Source Package Dossier (Downloads + Security + Repo) Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "packages": {
      "title": "Package Names",
      "type": "array",
      "description": "Package names to audit (e.g. [\"express\", \"axios\", \"lodash\"]).",
      "editor": "stringList",
      "default": [
        "express"
      ],
      "prefill": [
        "express"
      ]
    },
    "maxItemsPerTarget": {
      "title": "Max Items Per Target",
      "type": "integer",
      "description": "Maximum number of records to extract per target query.",
      "default": 10,
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "packages"
  ]
}