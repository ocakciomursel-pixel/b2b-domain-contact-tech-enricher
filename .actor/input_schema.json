{
  "title": "Maritime Shipping Carrier, Port Authority & Container Spy Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "domains": {
      "title": "Shipping Line or Port Domains",
      "type": "array",
      "description": "Domains to inspect (e.g. [\"maersk.com\"]).",
