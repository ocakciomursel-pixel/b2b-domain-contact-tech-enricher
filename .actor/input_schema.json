{
  "title": "SEC EDGAR Public Company CIK, SIC & Regulatory Tracker Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tickers": {
      "title": "Stock Tickers or Company Keywords",
      "type": "array",
      "description": "US stock tickers (e.g. [\"AAPL\", \"MSFT\", \"NVDA\"]).",
      "editor": "stringList",
      "default": [
        "AAPL",
        "NVDA"
      ],
      "prefill": [
