      "default": [
        "https://websummit.com"
      ],
      "prefill": [
        "https://websummit.com"
      ]
    },
    "maxItemsPerTarget": {
      "title": "Max Items Per Target",
      "type": "integer",
      "description": "Maximum number of records to extract per target query.",
