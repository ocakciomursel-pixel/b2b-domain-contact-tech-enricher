{
  "title": "WooCommerce Store Product Catalog, SKU & Pricing Extractor Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "domains": {
      "title": "WooCommerce Store Domains",
      "type": "array",
      "description": "Domains of stores to inspect (e.g. [\"woocommerce.com\"]).",
      "editor": "stringList",
      "default": [
        "woocommerce.com"
      ],
      "prefill": [
        "woocommerce.com"
      ]
    },
    "maxItemsPerTarget": {
      "title": "Max Items Per Target",
      "type": "integer",
      "description": "Maximum number of records to extract per target query.",
      "default": 10,
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "domains"
  ]
}