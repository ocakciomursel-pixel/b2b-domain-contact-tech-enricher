{
  "title": "Event, Conference & Ticketing (Eventbrite/Luma) Schema Extractor Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "urls": {
      "title": "Event or Conference Page URLs",
      "type": "array",
      "description": "URLs of event pages.",
