  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tokens": {
      "title": "Token Symbols or Names",
      "type": "array",
      "description": "Crypto token symbols (e.g. [\"SOL\", \"AAVE\", \"UNI\"]).",
      "editor": "stringList",
      "default": [
