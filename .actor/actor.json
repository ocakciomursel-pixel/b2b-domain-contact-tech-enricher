{
  "actorSpecification": 1,
  "name": "saas-pricing-page-tier-feature-extractor",
  "title": "SaaS Pricing Page Tier, Plan, Currency & Feature Matrix Spy",
  "description": "Locate and analyze SaaS competitor /pricing pages to extract detected price points, billing models (per-seat, usage-based, freemium, free trial), and enterprise tiers.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "SaaS Pricing Page Tier, Plan, Currency & Feature Matrix Spy (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "domain",
              "pricingUrl",
              "hasFreeTier",
              "hasFreeTrial",
              "hasEnterpriseTier",
              "billingSignals",
              "detectedPrices"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "SaaS Domain",
                "format": "text"
              },
              "pricingUrl": {
                "label": "Pricing URL",
                "format": "link"
              },
              "hasFreeTier": {
                "label": "Free Tier",
                "format": "boolean"
              },
              "hasFreeTrial": {
                "label": "Free Trial",
                "format": "boolean"
              },
              "hasEnterpriseTier": {
                "label": "Enterprise Plan",
                "format": "boolean"
              },
              "billingSignals": {
                "label": "Billing Model Signals",
                "format": "array"
              },
              "detectedPrices": {
                "label": "Detected Price Points",
                "format": "array"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "title": "domain",
            "description": "Extracted domain"
          },
          "pricingUrl": {
            "type": "string",
            "title": "pricingUrl",
            "description": "Extracted pricingUrl"
          },
          "hasFreeTier": {
            "type": "boolean",
            "title": "hasFreeTier",
            "description": "Extracted hasFreeTier"
          },
          "hasEnterpriseTier": {
            "type": "boolean",
            "title": "hasEnterpriseTier",
            "description": "Extracted hasEnterpriseTier"
          },
          "billingSignals": {
            "type": "array",
            "title": "billingSignals",
            "description": "Extracted billingSignals"
          },
          "detectedPrices": {
            "type": "array",
            "title": "detectedPrices",
            "description": "Extracted detectedPrices"
          },
          "planHeadings": {
            "type": "array",
            "title": "planHeadings",
            "description": "Extracted planHeadings"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}