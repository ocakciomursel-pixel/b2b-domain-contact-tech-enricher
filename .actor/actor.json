      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "name",
              "symbol",
              "category",
              "tvlUsd",
              "change1dPct",
              "change7dPct",
              "mcapToTvlRatio",
              "chains",
              "url"
