{
  "actorSpecification": 1,
  "name": "reddit-community-pain-point-trend-miner",
  "title": "Reddit Subreddit, Buyer Intent & Pain-Point Lead Miner",
  "description": "Mine Reddit subreddits for high-intent buyer questions, software alternatives discussions, pain points, upvote velocity, and engagement signals.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Reddit Subreddit, Buyer Intent & Pain-Point Lead Miner (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "subreddit",
              "title",
              "buyerIntentSignals",
              "score",
              "numComments",
              "author",
              "permalink"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "subreddit": {
                "label": "Subreddit",
                "format": "text"
              },
              "title": {
                "label": "Post Title",
                "format": "text"
              },
              "buyerIntentSignals": {
                "label": "Intent Signals",
                "format": "array"
              },
              "score": {
                "label": "Upvotes",
                "format": "number"
              },
              "numComments": {
                "label": "Comments",
                "format": "number"
              },
              "author": {
                "label": "Author",
                "format": "text"
              },
              "permalink": {
                "label": "Reddit Link",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "subreddit": {
            "type": "string",
            "title": "subreddit",
            "description": "Extracted subreddit"
          },
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "buyerIntentSignals": {
            "type": "array",
            "title": "buyerIntentSignals",
            "description": "Extracted buyerIntentSignals"
          },
          "hasBuyerIntent": {
            "type": "boolean",
            "title": "hasBuyerIntent",
            "description": "Extracted hasBuyerIntent"
          },
          "author": {
            "type": "string",
            "title": "author",
            "description": "Extracted author"
          },
          "permalink": {
            "type": "string",
            "title": "permalink",
            "description": "Extracted permalink"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}