{
  "actorSpecification": 1,
  "name": "dexscreener-onchain-token-liquidity-pair-monitor",
  "title": "DexScreener On-Chain Token Liquidity, Volume & Pair Monitor",
  "description": "On-chain DeFi & DEX market intelligence: extracts live decentralized exchange trading pairs, pool liquidity in USD, 24-hour buy vs. sell transaction counts, and fully diluted valuation (FDV).",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "DexScreener On-Chain Token Liquidity, Volume & Pair Monitor",
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "title": "Target Query"
          },
          "extractedAt": {
            "type": "string",
            "title": "Extracted Timestamp"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "target",
              "extractedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "target": {
                "label": "Target",
                "format": "text"
              },
              "extractedAt": {
                "label": "Extracted At",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}