{
  "actorSpecification": 1,
  "name": "apple-appstore-aso-competitor-review-intel",
  "title": "Apple App Store ASO, Competitor Metadata & User Complaint Miner (MCP Ready)",
  "description": "Mobile App & Gaming intelligence Actor: extracts iOS App Store ratings, version velocity, developer websites, and mines recent user reviews to identify 1-2 star bug/complaint themes.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Apple App Store ASO, Competitor Metadata & User Complaint Miner (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "trackName",
              "sellerName",
              "averageUserRating",
              "userRatingCount",
              "version",
              "lowStarComplaintsCount",
              "complaintThemes",
              "sellerUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "trackName": {
                "label": "App Name",
                "format": "text"
              },
              "sellerName": {
                "label": "Developer",
                "format": "text"
              },
              "averageUserRating": {
                "label": "Avg Rating",
                "format": "number"
              },
              "userRatingCount": {
                "label": "Ratings Count",
                "format": "number"
              },
              "version": {
                "label": "Version",
                "format": "text"
              },
              "lowStarComplaintsCount": {
                "label": "Recent 1-2★ Reviews",
                "format": "number"
              },
              "complaintThemes": {
                "label": "Detected Complaint Themes",
                "format": "array"
              },
              "sellerUrl": {
                "label": "Developer Website",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}