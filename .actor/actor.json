{
  "actorSpecification": 1,
  "name": "wordpress-woocommerce-site-spy",
  "title": "WordPress & WooCommerce Theme, Plugin & REST API Intelligenc",
  "description": "Detect active WordPress themes, installed plugins, WooCommerce e-commerce status, REST API namespaces, and published metadata on any domain.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "WordPress & WooCommerce Theme, Plugin & REST API Intelligence Spy (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "domain",
              "isWordPress",
              "isWooCommerce",
              "activeTheme",
              "detectedPlugins",
              "restNamespaces"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "isWordPress": {
                "label": "WordPress",
                "format": "boolean"
              },
              "isWooCommerce": {
                "label": "WooCommerce",
                "format": "boolean"
              },
              "activeTheme": {
                "label": "Active Theme",
                "format": "text"
              },
              "detectedPlugins": {
                "label": "Detected Plugins",
                "format": "array"
              },
              "restNamespaces": {
                "label": "REST Namespaces",
                "format": "array"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "title": "domain",
            "description": "Extracted domain"
          },
          "siteName": {
            "type": "string",
            "title": "siteName",
            "description": "Extracted siteName"
          },
          "isWordPress": {
            "type": "boolean",
            "title": "isWordPress",
            "description": "Extracted isWordPress"
          },
          "isWooCommerce": {
            "type": "boolean",
            "title": "isWooCommerce",
            "description": "Extracted isWooCommerce"
          },
          "activeTheme": {
            "type": "string",
            "title": "activeTheme",
            "description": "Extracted activeTheme"
          },
          "detectedPlugins": {
            "type": "array",
            "title": "detectedPlugins",
            "description": "Extracted detectedPlugins"
          },
          "restNamespaces": {
            "type": "array",
            "title": "restNamespaces",
            "description": "Extracted restNamespaces"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}