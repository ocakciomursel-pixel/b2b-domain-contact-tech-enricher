          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Protocol",
                "format": "text"
              },
              "symbol": {
                "label": "Token",
                "format": "text"
              },
              "category": {
                "label": "Category",
                "format": "text"
              },
              "tvlUsd": {
                "label": "TVL (USD)",
                "format": "number"
              },
              "change1dPct": {
                "label": "1d Change %",
                "format": "number"
              },
              "change7dPct": {
                "label": "7d Change %",
                "format": "number"
              },
              "mcapToTvlRatio": {
                "label": "Mcap / TVL",
                "format": "number"
              },
              "chains": {
                "label": "Chains",
                "format": "array"
              },
              "url": {
                "label": "Website",
                "format": "link"
              }
            }
          }
        }
      }
    }
  },
  "seoTitle": "DeFiLlama TVL Scraper, Crypto Capital Flow & Protocol Valuation Tool",
