{
  "actorSpecification": 1,
  "name": "global-news-pr-sentiment-mention-monitor",
  "title": "Global News, PR Mention, Event Classifier & Brand Sentiment",
  "description": "PR, Media & Financial News intelligence Actor: monitors real-time Google News RSS feeds for any company, brand, or market keyword with automated sentiment scoring and corporate event classification.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Global News, PR Mention, Event Classifier & Brand Sentiment Monitor (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "query",
              "title",
              "publisher",
              "sentimentLabel",
              "eventCategories",
              "publishedAt",
              "link"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "query": {
                "label": "Keyword",
                "format": "text"
              },
              "title": {
                "label": "Headline",
                "format": "text"
              },
              "publisher": {
                "label": "Publisher",
                "format": "text"
              },
              "sentimentLabel": {
                "label": "Sentiment",
                "format": "text"
              },
              "eventCategories": {
                "label": "Corporate Events",
                "format": "array"
              },
              "publishedAt": {
                "label": "Published At",
                "format": "text"
              },
              "link": {
                "label": "Article Link",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "title": "query",
            "description": "Extracted query"
          },
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "publisher": {
            "type": "string",
            "title": "publisher",
            "description": "Extracted publisher"
          },
          "sentimentLabel": {
            "type": "string",
            "title": "sentimentLabel",
            "description": "Extracted sentimentLabel"
          },
          "eventCategories": {
            "type": "array",
            "title": "eventCategories",
            "description": "Extracted eventCategories"
          },
          "publishedAt": {
            "type": "string",
            "title": "publishedAt",
            "description": "Extracted publishedAt"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}