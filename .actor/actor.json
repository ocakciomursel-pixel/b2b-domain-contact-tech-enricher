                "label": "Job Title",
                "format": "text"
              },
              "department": {
                "label": "Department",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "isRemote": {
                "label": "Remote",
                "format": "boolean"
              },
              "updatedAt": {
                "label": "Updated At",
                "format": "text"
              },
              "applyUrl": {
                "label": "Apply URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
