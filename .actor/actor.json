{
  "actorSpecification": 1,
  "name": "vscode-marketplace-extension-publisher-spy",
  "title": "VS Code & OpenVSX Extension Publisher, Downloads & Repo Spy",
  "description": "Developer tools & IDE market intelligence: extracts extension install counts, ratings, publisher identities, and source code repositories from the OpenVSX registry.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "VS Code & OpenVSX Extension Publisher, Downloads & Repo Spy",
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "title": "Target Query"
          },
          "extractedAt": {
            "type": "string",
            "title": "Extracted Timestamp"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "target",
              "extractedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "target": {
                "label": "Target",
                "format": "text"
              },
              "extractedAt": {
                "label": "Extracted At",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}