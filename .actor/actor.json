{
  "actorSpecification": 1,
  "name": "podcast-rss-host-sponsor-email-extractor",
  "title": "Podcast RSS Feed, Host Direct Email & Episode Lead Extractor",
  "description": "Find podcasts by niche keyword via Apple Podcasts API, parse their RSS XML feeds, and extract verified host/producer email addresses, episode counts, and website links.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Podcast RSS Feed, Host Direct Email & Episode Lead Extractor (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "podcastTitle",
              "hostName",
              "ownerEmails",
              "primaryGenre",
              "trackCount",
              "websiteUrl",
              "feedUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "podcastTitle": {
                "label": "Podcast Title",
                "format": "text"
              },
              "hostName": {
                "label": "Host / Author",
                "format": "text"
              },
              "ownerEmails": {
                "label": "Direct Host Emails",
                "format": "array"
              },
              "primaryGenre": {
                "label": "Genre",
                "format": "text"
              },
              "trackCount": {
                "label": "Episodes",
                "format": "number"
              },
              "websiteUrl": {
                "label": "Website",
                "format": "link"
              },
              "feedUrl": {
                "label": "RSS Feed",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "podcastTitle": {
            "type": "string",
            "title": "podcastTitle",
            "description": "Extracted podcastTitle"
          },
          "hostName": {
            "type": "string",
            "title": "hostName",
            "description": "Extracted hostName"
          },
          "ownerEmails": {
            "type": "array",
            "title": "ownerEmails",
            "description": "Extracted ownerEmails"
          },
          "primaryGenre": {
            "type": "string",
            "title": "primaryGenre",
            "description": "Extracted primaryGenre"
          },
          "trackCount": {
            "type": "number",
            "title": "trackCount",
            "description": "Extracted trackCount"
          },
          "websiteUrl": {
            "type": "string",
            "title": "websiteUrl",
            "description": "Extracted websiteUrl"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}