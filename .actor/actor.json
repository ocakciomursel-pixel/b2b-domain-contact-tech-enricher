{
  "actorSpecification": 1,
  "name": "domain-cybersecurity-ssl-dns-vulnerability-auditor",
  "title": "Domain Cybersecurity, SPF/DMARC, DNS & Security Auditor",
  "description": "Enterprise Cybersecurity & MSP Lead Actor: audits any domain for SPF, DMARC, MX email security providers, CAA records, HTTP security headers (HSTS, CSP, X-Frame-Options), and computes a 0-100 Security Posture Score.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Domain Cybersecurity, DNS (SPF/DMARC), Email Provider & Security Header Auditor (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "domain",
              "securityScore",
              "emailProvider",
              "hasSpf",
              "hasDmarc",
              "hasHsts",
              "hasCsp",
              "vulnerabilities"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "securityScore": {
                "label": "Security Score (0-100)",
                "format": "number"
              },
              "emailProvider": {
                "label": "Email Gateway / MX",
                "format": "text"
              },
              "hasSpf": {
                "label": "SPF",
                "format": "boolean"
              },
              "hasDmarc": {
                "label": "DMARC",
                "format": "boolean"
              },
              "hasHsts": {
                "label": "HSTS",
                "format": "boolean"
              },
              "hasCsp": {
                "label": "CSP",
                "format": "boolean"
              },
              "vulnerabilities": {
                "label": "Security Findings",
                "format": "array"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "title": "domain",
            "description": "Extracted domain"
          },
          "securityScore": {
            "type": "number",
            "title": "securityScore",
            "description": "Extracted securityScore"
          },
          "emailProvider": {
            "type": "string",
            "title": "emailProvider",
            "description": "Extracted emailProvider"
          },
          "hasSpf": {
            "type": "boolean",
            "title": "hasSpf",
            "description": "Extracted hasSpf"
          },
          "hasDmarc": {
            "type": "boolean",
            "title": "hasDmarc",
            "description": "Extracted hasDmarc"
          },
          "hasHsts": {
            "type": "boolean",
            "title": "hasHsts",
            "description": "Extracted hasHsts"
          },
          "hasCsp": {
            "type": "boolean",
            "title": "hasCsp",
            "description": "Extracted hasCsp"
          },
          "vulnerabilities": {
            "type": "array",
            "title": "vulnerabilities",
            "description": "Extracted vulnerabilities"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}