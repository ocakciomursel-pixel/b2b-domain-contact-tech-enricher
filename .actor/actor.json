{
  "actorSpecification": 1,
  "name": "defi-protocol-yield-tvl-whale-intel",
  "title": "DeFi Protocol TVL, Capital Flow & High-Yield Pool Intelligen",
  "description": "Institutional Crypto & DeFi intelligence Actor: tracks protocol TVL, 1d/7d/30d capital inflows/outflows, multi-chain exposure, Mcap/TVL valuation multiples, and audit status via DeFiLlama.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "DeFi Protocol TVL, Capital Flow & High-Yield Pool Intelligence (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "name",
              "symbol",
              "category",
              "tvlUsd",
              "change1dPct",
              "change7dPct",
              "mcapToTvlRatio",
              "chains",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Protocol",
                "format": "text"
              },
              "symbol": {
                "label": "Token",
                "format": "text"
              },
              "category": {
                "label": "Category",
                "format": "text"
              },
              "tvlUsd": {
                "label": "TVL (USD)",
                "format": "number"
              },
              "change1dPct": {
                "label": "1d Change %",
                "format": "number"
              },
              "change7dPct": {
                "label": "7d Change %",
                "format": "number"
              },
              "mcapToTvlRatio": {
                "label": "Mcap / TVL",
                "format": "number"
              },
              "chains": {
                "label": "Chains",
                "format": "array"
              },
              "url": {
                "label": "Website",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "description": "Extracted name"
          },
          "symbol": {
            "type": "string",
            "title": "symbol",
            "description": "Extracted symbol"
          },
          "category": {
            "type": "string",
            "title": "category",
            "description": "Extracted category"
          },
          "tvlUsd": {
            "type": "number",
            "title": "tvlUsd",
            "description": "Extracted tvlUsd"
          },
          "mcapToTvlRatio": {
            "type": "number",
            "title": "mcapToTvlRatio",
            "description": "Extracted mcapToTvlRatio"
          },
          "change1dPct": {
            "type": "number",
            "title": "change1dPct",
            "description": "Extracted change1dPct"
          },
          "chains": {
            "type": "array",
            "title": "chains",
            "description": "Extracted chains"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}