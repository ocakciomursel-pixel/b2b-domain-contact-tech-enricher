{
  "actorSpecification": 1,
  "name": "local-business-hotel-restaurant-schema-extractor",
  "title": "Local Business Leads Scraper — Hotel, Clinic & Restaurant",
  "description": "Extract verified local business leads directly from hotel, clinic, dentist, lawyer, and restaurant websites: scrape Schema.org LocalBusiness JSON-LD, emails, phone numbers, street addresses, geo coordinates, and opening hours ($3/1k businesses).",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Local Business, Hotel, Clinic & Real Estate Schema.org Contact Extractor (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "domain",
              "businessName",
              "businessType",
              "telephone",
              "emails",
              "streetAddress",
              "addressLocality",
              "aggregateRating"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "businessName": {
                "label": "Business Name",
                "format": "text"
              },
              "businessType": {
                "label": "Schema Type",
                "format": "text"
              },
              "telephone": {
                "label": "Phone",
                "format": "text"
              },
              "emails": {
                "label": "Emails",
                "format": "array"
              },
              "streetAddress": {
                "label": "Address",
                "format": "text"
              },
              "addressLocality": {
                "label": "City",
                "format": "text"
              },
              "aggregateRating": {
                "label": "Rating",
                "format": "number"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "title": "domain",
            "description": "Extracted domain"
          },
          "businessName": {
            "type": "string",
            "title": "businessName",
            "description": "Extracted businessName"
          },
          "businessType": {
            "type": "string",
            "title": "businessType",
            "description": "Extracted businessType"
          },
          "telephone": {
            "type": "string",
            "title": "telephone",
            "description": "Extracted telephone"
          },
          "emails": {
            "type": "array",
            "title": "emails",
            "description": "Extracted emails"
          },
          "addressLocality": {
            "type": "string",
            "title": "addressLocality",
            "description": "Extracted addressLocality"
          },
          "aggregateRating": {
            "type": "number",
            "title": "aggregateRating",
            "description": "Extracted aggregateRating"
          }
        }
      }
    }
  },
  "output": "./output_schema.json",
  "categories": [
    "LEAD_GENERATION",
    "AI",
    "BUSINESS",
    "TRAVEL"
  ]
}