{
  "actorSpecification": 1,
  "name": "hackernews-tech-launch-lead-monitor",
  "title": "Hacker News Launch, Show HN & Tech Founder Lead Monitor",
  "description": "Monitor Hacker News (Show HN, Ask HN, and top tech stories) by keyword to discover newly launched startups, founder handles, outbound domains, and community traction.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Hacker News Show HN, Startup Launch & Tech Trend Intelligence (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "title",
              "author",
              "points",
              "numComments",
              "externalDomain",
              "externalUrl",
              "hnUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Story Title",
                "format": "text"
              },
              "author": {
                "label": "Founder / Author",
                "format": "text"
              },
              "points": {
                "label": "Points",
                "format": "number"
              },
              "numComments": {
                "label": "Comments",
                "format": "number"
              },
              "externalDomain": {
                "label": "Startup Domain",
                "format": "text"
              },
              "externalUrl": {
                "label": "External URL",
                "format": "link"
              },
              "hnUrl": {
                "label": "HN Discussion",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "isShowHN": {
            "type": "boolean",
            "title": "isShowHN",
            "description": "Extracted isShowHN"
          },
          "author": {
            "type": "string",
            "title": "author",
            "description": "Extracted author"
          },
          "points": {
            "type": "number",
            "title": "points",
            "description": "Extracted points"
          },
          "numComments": {
            "type": "number",
            "title": "numComments",
            "description": "Extracted numComments"
          },
          "externalDomain": {
            "type": "string",
            "title": "externalDomain",
            "description": "Extracted externalDomain"
          },
          "hnUrl": {
            "type": "string",
            "title": "hnUrl",
            "description": "Extracted hnUrl"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}