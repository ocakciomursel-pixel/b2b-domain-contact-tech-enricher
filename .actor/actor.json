{
  "actorSpecification": 1,
  "name": "ats-job-board-hiring-signal-scraper",
  "title": "Greenhouse & Lever Company Job Board & Hiring Signal Scraper",
  "description": "Extract active job openings, departments, remote status, locations, and B2B hiring intent signals directly from Greenhouse and Lever company job boards.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Greenhouse & Lever Company Job Board & Hiring Signal Scraper (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "company",
              "atsPlatform",
              "title",
              "department",
              "location",
              "isRemote",
              "updatedAt",
              "applyUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "company": {
                "label": "Company",
                "format": "text"
              },
              "atsPlatform": {
                "label": "ATS",
                "format": "text"
              },
              "title": {
                "label": "Job Title",
                "format": "text"
              },
              "department": {
                "label": "Department",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "isRemote": {
                "label": "Remote",
                "format": "boolean"
              },
              "updatedAt": {
                "label": "Updated At",
                "format": "text"
              },
              "applyUrl": {
                "label": "Apply URL",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "title": "company",
            "description": "Extracted company"
          },
          "atsPlatform": {
            "type": "string",
            "title": "atsPlatform",
            "description": "Extracted atsPlatform"
          },
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "department": {
            "type": "string",
            "title": "department",
            "description": "Extracted department"
          },
          "location": {
            "type": "string",
            "title": "location",
            "description": "Extracted location"
          },
          "isRemote": {
            "type": "boolean",
            "title": "isRemote",
            "description": "Extracted isRemote"
          },
          "applyUrl": {
            "type": "string",
            "title": "applyUrl",
            "description": "Extracted applyUrl"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}