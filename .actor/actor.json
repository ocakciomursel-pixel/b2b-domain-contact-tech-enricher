{
  "actorSpecification": 1,
  "name": "bug-bounty-security-txt-responsible-disclosure-finder",
  "title": "Security.txt, Bug Bounty Program & CISO Contact Finder",
  "description": "Cybersecurity B2B lead & bug bounty discovery tool: scans target domains for RFC 9116 security.txt files to extract security contacts, policy links, encryption keys, and hiring pages.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Security.txt, Bug Bounty Program & CISO Contact Finder",
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "title": "Target Query"
          },
          "extractedAt": {
            "type": "string",
            "title": "Extracted Timestamp"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "target",
              "extractedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "target": {
                "label": "Target",
                "format": "text"
              },
              "extractedAt": {
                "label": "Extracted At",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}