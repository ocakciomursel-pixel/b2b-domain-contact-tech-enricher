{
  "actorSpecification": 1,
  "name": "github-developer-recruiter-lead-enricher",
  "title": "GitHub Developer, Stargazer & Contributor Lead Enricher",
  "description": "Extract developer profiles, public commit emails, company affiliations, personal websites, X/Twitter handles, location, and hireable status from GitHub repositories or username lists.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "GitHub Developer Leads",
      "views": {
        "overview": {
          "title": "Enriched Developer Profiles",
          "transformation": {
            "fields": [
              "username",
              "name",
              "emails",
              "company",
              "location",
              "hireable",
              "blogUrl",
              "twitterUsername",
              "followers",
              "publicRepos",
              "sourceRepo",
              "profileUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "username": {
                "label": "Username",
                "format": "text"
              },
              "name": {
                "label": "Full Name",
                "format": "text"
              },
              "emails": {
                "label": "Verified / Commit Emails",
                "format": "array"
              },
              "company": {
                "label": "Company",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "hireable": {
                "label": "Hireable",
                "format": "boolean"
              },
              "blogUrl": {
                "label": "Website / Blog",
                "format": "link"
              },
              "twitterUsername": {
                "label": "X / Twitter",
                "format": "text"
              },
              "followers": {
                "label": "Followers",
                "format": "number"
              },
              "publicRepos": {
                "label": "Public Repos",
                "format": "number"
              },
              "sourceRepo": {
                "label": "Source Repo",
                "format": "text"
              },
              "profileUrl": {
                "label": "GitHub Profile",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "title": "username",
            "description": "Extracted username"
          },
          "name": {
            "type": "string",
            "title": "name",
            "description": "Extracted name"
          },
          "emails": {
            "type": "array",
            "title": "emails",
            "description": "Extracted emails"
          },
          "company": {
            "type": "string",
            "title": "company",
            "description": "Extracted company"
          },
          "location": {
            "type": "string",
            "title": "location",
            "description": "Extracted location"
          },
          "hireable": {
            "type": "boolean",
            "title": "hireable",
            "description": "Extracted hireable"
          },
          "blogUrl": {
            "type": "string",
            "title": "blogUrl",
            "description": "Extracted blogUrl"
          },
          "followers": {
            "type": "number",
            "title": "followers",
            "description": "Extracted followers"
          },
          "repoContributions": {
            "type": "number",
            "title": "repoContributions",
            "description": "Extracted repoContributions"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}