{
  "actorSpecification": 1,
  "name": "scientific-literature-citation-author-lead-miner",
  "title": "Scientific Paper, Author Email & Lab Research Lead Miner",
  "description": "DeepTech & Academic R&D intelligence Actor: mines OpenAlex for peer-reviewed papers, citation velocity, open-access PDFs, funding grants, and researcher institution leads.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Scientific Literature, R&D Grant, Institution & Author Lead Miner (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "title",
              "publicationYear",
              "citedByCount",
              "firstAuthor",
              "institutions",
              "openAccessPdfUrl",
              "doiUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Paper Title",
                "format": "text"
              },
              "publicationYear": {
                "label": "Year",
                "format": "number"
              },
              "citedByCount": {
                "label": "Citations",
                "format": "number"
              },
              "firstAuthor": {
                "label": "Lead Researcher",
                "format": "text"
              },
              "institutions": {
                "label": "Institutions / Labs",
                "format": "array"
              },
              "openAccessPdfUrl": {
                "label": "Open Access PDF",
                "format": "link"
              },
              "doiUrl": {
                "label": "DOI Link",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "publicationYear": {
            "type": "number",
            "title": "publicationYear",
            "description": "Extracted publicationYear"
          },
          "citedByCount": {
            "type": "number",
            "title": "citedByCount",
            "description": "Extracted citedByCount"
          },
          "firstAuthor": {
            "type": "string",
            "title": "firstAuthor",
            "description": "Extracted firstAuthor"
          },
          "institutions": {
            "type": "array",
            "title": "institutions",
            "description": "Extracted institutions"
          },
          "isOpenAccess": {
            "type": "boolean",
            "title": "isOpenAccess",
            "description": "Extracted isOpenAccess"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}