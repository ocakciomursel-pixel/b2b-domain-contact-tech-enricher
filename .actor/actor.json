{
  "actorSpecification": 1,
  "name": "ai-ready-website-to-markdown-rag-crawler",
  "title": "AI & LLM Website to Clean Markdown, RAG Chunks & Metadata",
  "description": "Convert any webpage or documentation site into clean LLM-ready Markdown, overlapping RAG text chunks with estimated token counts, and JSON-LD/OpenGraph metadata.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "LLM Markdown & RAG Chunks",
      "views": {
        "overview": {
          "title": "Extracted Markdown & Chunks",
          "transformation": {
            "fields": [
              "url",
              "title",
              "estimatedTokens",
              "chunksCount",
              "wordCount",
              "markdown",
              "chunks"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "URL",
                "format": "link"
              },
              "title": {
                "label": "Title",
                "format": "text"
              },
              "estimatedTokens": {
                "label": "Est. Tokens",
                "format": "number"
              },
              "chunksCount": {
                "label": "RAG Chunks",
                "format": "number"
              },
              "wordCount": {
                "label": "Words",
                "format": "number"
              },
              "markdown": {
                "label": "Clean Markdown",
                "format": "text"
              },
              "chunks": {
                "label": "Chunks Array",
                "format": "array"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "url",
            "description": "Extracted url"
          },
          "title": {
            "type": "string",
            "title": "title",
            "description": "Extracted title"
          },
          "wordCount": {
            "type": "number",
            "title": "wordCount",
            "description": "Extracted wordCount"
          },
          "estimatedTokens": {
            "type": "number",
            "title": "estimatedTokens",
            "description": "Extracted estimatedTokens"
          },
          "chunksCount": {
            "type": "number",
            "title": "chunksCount",
            "description": "Extracted chunksCount"
          },
          "markdown": {
            "type": "string",
            "title": "markdown",
            "description": "Extracted markdown"
          },
          "chunks": {
            "type": "array",
            "title": "chunks",
            "description": "Extracted chunks"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}