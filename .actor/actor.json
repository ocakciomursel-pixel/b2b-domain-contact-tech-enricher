{
  "actorSpecification": 1,
  "name": "clinical-trials-fda-drug-safety-intel",
  "title": "ClinicalTrials.gov & OpenFDA Drug Safety & Biotech Lead Intelligence (MCP Ready)",
  "description": "Enterprise Healthcare & Pharma intelligence Actor: combines ClinicalTrials.gov API v2 and OpenFDA to extract active clinical trials, phases, lead sponsors, principal investigator contacts, eligibility criteria, and FDA adverse event safety signals.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "ClinicalTrials.gov & OpenFDA Drug Safety & Biotech Lead Intelligence (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Intelligence",
          "transformation": {
            "fields": [
              "nctId",
              "briefTitle",
              "overallStatus",
              "phases",
              "leadSponsor",
              "conditions",
              "centralContacts",
              "fdaAdverseEventsTotal"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "nctId": {
                "label": "NCT ID",
                "format": "text"
              },
              "briefTitle": {
                "label": "Study Title",
                "format": "text"
              },
              "overallStatus": {
                "label": "Status",
                "format": "text"
              },
              "phases": {
                "label": "Phases",
                "format": "array"
              },
              "leadSponsor": {
                "label": "Lead Sponsor",
                "format": "text"
              },
              "conditions": {
                "label": "Conditions",
                "format": "array"
              },
              "centralContacts": {
                "label": "PI / Study Contacts",
                "format": "array"
              },
              "fdaAdverseEventsTotal": {
                "label": "FDA Adverse Reports",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}