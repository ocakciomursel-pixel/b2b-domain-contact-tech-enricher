{
  "actorSpecification": 1,
  "name": "apple-appstore-aso-competitor-review-intel",
  "title": "Apple App Store Scraper — iOS App Reviews, Ratings & ASO",
  "description": "Scrape Apple iOS App Store apps, user reviews, star ratings, version history, pricing, bundle IDs, and publisher contact links. Extract 1-3 star pain points for mobile ASO, competitor research, and app agency lead generation ($2/1k records).",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Apple App Store ASO, Competitor Metadata & User Complaint Miner (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "trackName",
              "sellerName",
              "averageUserRating",
              "userRatingCount",
              "version",
              "lowStarComplaintsCount",
              "complaintThemes",
              "sellerUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "trackName": {
                "label": "App Name",
                "format": "text"
              },
              "sellerName": {
                "label": "Developer",
                "format": "text"
              },
              "averageUserRating": {
                "label": "Avg Rating",
                "format": "number"
              },
              "userRatingCount": {
                "label": "Ratings Count",
                "format": "number"
              },
              "version": {
                "label": "Version",
                "format": "text"
              },
              "lowStarComplaintsCount": {
                "label": "Recent 1-2★ Reviews",
                "format": "number"
              },
              "complaintThemes": {
                "label": "Detected Complaint Themes",
                "format": "array"
              },
              "sellerUrl": {
                "label": "Developer Website",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "trackName": {
            "type": "string",
            "title": "trackName",
            "description": "Extracted trackName"
          },
          "sellerName": {
            "type": "string",
            "title": "sellerName",
            "description": "Extracted sellerName"
          },
          "averageUserRating": {
            "type": "number",
            "title": "averageUserRating",
            "description": "Extracted averageUserRating"
          },
          "userRatingCount": {
            "type": "number",
            "title": "userRatingCount",
            "description": "Extracted userRatingCount"
          },
          "lowStarComplaintsCount": {
            "type": "number",
            "title": "lowStarComplaintsCount",
            "description": "Extracted lowStarComplaintsCount"
          },
          "complaintThemes": {
            "type": "array",
            "title": "complaintThemes",
            "description": "Extracted complaintThemes"
          },
          "sellerUrl": {
            "type": "string",
            "title": "sellerUrl",
            "description": "Extracted sellerUrl"
          }
        }
      }
    }
  },
  "output": "./output_schema.json",
  "categories": [
    "AI",
    "ECOMMERCE",
    "MARKETING",
    "LEAD_GENERATION"
  ]
}