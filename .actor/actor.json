{
  "actorSpecification": 1,
  "name": "open-source-package-maintainer-security-intel",
  "title": "NPM & PyPI Package Maintainer Email, Download & Supply-Chain",
  "description": "DevTools & Supply-Chain intelligence Actor: extracts NPM and PyPI package download volume, maintainer direct email addresses, license compliance, dependency counts, and release freshness.",
  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "NPM & PyPI Package Maintainer Email, Download & Supply-Chain Intelligence (MCP Ready)",
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "transformation": {
            "fields": [
              "ecosystem",
              "packageName",
              "latestVersion",
              "license",
              "monthlyDownloads",
              "maintainerEmails",
              "repositoryUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "ecosystem": {
                "label": "Ecosystem",
                "format": "text"
              },
              "packageName": {
                "label": "Package",
                "format": "text"
              },
              "latestVersion": {
                "label": "Latest Version",
                "format": "text"
              },
              "license": {
                "label": "License",
                "format": "text"
              },
              "monthlyDownloads": {
                "label": "30d Downloads",
                "format": "number"
              },
              "maintainerEmails": {
                "label": "Maintainer Emails",
                "format": "array"
              },
              "repositoryUrl": {
                "label": "Repository",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ecosystem": {
            "type": "string",
            "title": "ecosystem",
            "description": "Extracted ecosystem"
          },
          "packageName": {
            "type": "string",
            "title": "packageName",
            "description": "Extracted packageName"
          },
          "latestVersion": {
            "type": "string",
            "title": "latestVersion",
            "description": "Extracted latestVersion"
          },
          "license": {
            "type": "string",
            "title": "license",
            "description": "Extracted license"
          },
          "monthlyDownloads": {
            "type": "number",
            "title": "monthlyDownloads",
            "description": "Extracted monthlyDownloads"
          },
          "maintainerEmails": {
            "type": "array",
            "title": "maintainerEmails",
            "description": "Extracted maintainerEmails"
          },
          "repositoryUrl": {
            "type": "string",
            "title": "repositoryUrl",
            "description": "Extracted repositoryUrl"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}