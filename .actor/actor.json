  "version": "2.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Landing Page CRO, CTA, Live Chat & Conversion Funnel Auditor",
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "title": "Target Query"
          },
          "extractedAt": {
            "type": "string",
            "title": "Extracted Timestamp"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Enterprise Intelligence (V2.0)",
          "display": {
            "component": "table"
          }
        }
      }
    }
  },
  "categories": [
    "LEAD_GENERATION",
    "MCP_SERVERS",
    "AGENTS"
  ]
}